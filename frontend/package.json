{
  "name": "hockey-coach-workbench",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts index.html",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts index.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "jspdf": "4.2.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
